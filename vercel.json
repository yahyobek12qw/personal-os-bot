{
  "functions": {
    "api/telegram.ts": {
      "maxDuration": 60
    },
    "api/v2.ts": {
      "maxDuration": 60
    },
    "api/agent.ts": {
      "maxDuration": 60
    },
    "api/studio.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/studio/index.html"
    },
    {
      "source": "/app/",
      "destination": "/studio/index.html"
    }
  ]
}
